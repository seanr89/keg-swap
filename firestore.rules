rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin role documents: created manually in the console, never by clients.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Profiles: own doc, or any public profile (the client queries isPublic == true).
    // Connected friends can also fetch a profile directly via get, and signed-in users
    // may add their own uid to another user's friends list for mutual friend connections.
    match /users/{uid} {
      allow get: if isSignedIn()
        && (request.auth.uid == uid
          || resource.data.isPublic == true
          || request.auth.uid in resource.data.get('friends', []));
      allow list: if isSignedIn()
        && (request.auth.uid == uid || resource.data.isPublic == true);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn()
        && (request.auth.uid == uid
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
            && request.resource.data.friends is list
            && request.auth.uid in request.resource.data.friends
            && request.resource.data.friends.hasAll(resource.data.get('friends', []))
            && request.resource.data.friends.size() <= resource.data.get('friends', []).size() + 1));
      allow delete: if false;

      // Private bookmarks: one doc per event, readable and writable only by the owner.
      match /wishlists/{eventId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Friend codes: keyed by normalized friend code (e.g. KEG-7X9B). Any signed-in user
    // can resolve a specific code via get, while listing all codes is denied.
    match /friendCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Event venues: any signed-in user can read, only admins can change.
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Any signed-in user may update an event (attendees, status, drink count), but the
    // owner is fixed: otherwise a non-owner could claim an event and delete it.
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && request.resource.data.get('userId', null) == resource.data.get('userId', null);
      allow delete: if isSignedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);

      function isEventOwner() {
        return get(/databases/$(database)/documents/events/$(eventId)).data.get('userId', null) == request.auth.uid;
      }

      // Drinks and reviews are subcollections. Anyone signed in can add and edit them, as
      // when they were embedded in the event; deletes (used when an event is deleted)
      // are limited to the event's owner or an admin.
      match /drinks/{drinkId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isSignedIn() && (isAdmin() || isEventOwner());

        match /reviews/{reviewId} {
          allow read, create, update: if isSignedIn();
          allow delete: if isSignedIn() && (isAdmin() || isEventOwner());
        }
      }
    }

    // Collection-group reads: all reviews for one event, or all reviews by one user.
    match /{path=**}/reviews/{reviewId} {
      allow read: if isSignedIn();
    }
  }
}
